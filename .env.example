# Firebase Client (Public — safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK — paste your service account JSON as a single-line string
# Generate from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=

# Resend — email notification provider (https://resend.com)
RESEND_API_KEY=

# Cron protection secret (set same value in Vercel → Environment Variables)
CRON_SECRET=

# Set to "true" locally to bypass USCIS and use mock responses (do NOT set in production)
MOCK_USCIS=
